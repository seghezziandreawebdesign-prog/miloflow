# Copia in .env.local e compila. Su Vercel vanno impostate le stesse variabili.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pubblico dell'app (link nelle email). In locale http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo lato server (Server Actions e Route Handlers). MAI con prefisso NEXT_PUBLIC_.
# Per inserirla senza mostrarla a schermo: ./scripts/imposta-service-key.sh
SUPABASE_SERVICE_ROLE_KEY=
